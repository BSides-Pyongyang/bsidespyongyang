{
  "name": "bsides-pyongyang-site",
  "version": "1.0.0",
  "private": true,
  "description": "Hugo source and Cloudflare Worker deployment for bsidespyongyang.com",
  "scripts": {
    "build": "hugo --gc --minify",
    "dev": "hugo server --buildDrafts --disableFastRender",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "deploy:worker": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.123.0"
  },
  "engines": {
    "node": ">=22"
  }
}

